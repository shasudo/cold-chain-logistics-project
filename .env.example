# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
# `.env` is git-ignored — never commit real secrets.

# ---------- DeepSeek (the only LLM, required) ----------
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# deepseek-flash (fast, cheap, tool calls) or deepseek-v4-pro (flagship reasoning)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- SQL Server (telemetry DB) ----------
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433

# Read-only agent login (used by the app; created by scripts/setup_security_and_view.sql)
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=

# Admin login (used only by scripts/ingest_legacy_data.py for the one-time data load)
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=
